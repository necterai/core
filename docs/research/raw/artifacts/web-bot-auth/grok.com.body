  try {
    var location = window.location;
    var pathname = location.pathname;
    var stripped = pathname === '/plans' || pathname === '/plans/'
      ? ['stay_in_browser']
      : ['mwbv', 'stay_in_browser'];
    var pairs = location.search.slice(1).split('&').filter(function (pair) {
      return pair !== '';
    });
    var kept = pairs.filter(function (pair) {
      return stripped.indexOf(decodeURIComponent(pair.split('=')[0].replace(/\+/g, ' '))) === -1;
    });
    if (kept.length === pairs.length) return;
    var search = kept.length > 0 ? '?' + kept.join('&') : '';
    window.history.replaceState(window.history.state, '', pathname + search + location.hash);
  } catch (error) {}
})();</script><script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"SoftwareApplication","name":"Grok","alternateName":["Grok AI","SpaceXSI Grok"],"url":"https://grok.com","applicationCategory":"CommunicationApplication","operatingSystem":["Web","iOS","Android"],"description":"Grok is an AI-powered assistant built by SpaceXSI. Chat via text or voice, generate images and videos, search the web in real-time, write code, and reason through complex problems.","offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"creator":{"@type":"Organization","name":"xAI","url":"https://x.ai"},"featureList":["Text and voice chat","Image generation and editing","Video generation","Real-time web search","Code generation and debugging","Document analysis","Multilingual support","Advanced reasoning"]},{"@type":"Organization","name":"xAI","url":"https://x.ai","sameAs":["https://x.com/xai"]}]}</script><style>
